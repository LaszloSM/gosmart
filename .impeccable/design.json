  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink button for the main action of every screen.",
      "html": "<button class=\"ds-btn ds-btn-p\">Pagar $24.000 una sola vez</button>",
      "css": ".ds-btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 20px;border:0;border-radius:14px;font:750 16px/1 Archivo,system-ui,sans-serif;width:100%;cursor:pointer;transition:transform 140ms cubic-bezier(0.23,1,0.32,1),background-color 160ms ease}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}.ds-btn-p{background:var(--tinta,#172033);color:var(--cal,#F1F5F3)}.ds-btn-p:hover{background:color-mix(in srgb,var(--tinta,#172033) 88%,var(--turquesa,#1FB0A6))}"
    },
    {
      "name": "Turquoise Button",
      "kind": "button",
      "refersTo": "button-turquesa",
      "description": "State action on the open/calm color.",
      "html": "<button class=\"ds-btn-t\">Confirmar ruta</button>",
      "css": ".ds-btn-t{display:flex;align-items:center;justify-content:center;min-height:52px;padding:0 20px;border:0;border-radius:14px;font:750 16px/1 Archivo,system-ui,sans-serif;width:100%;background:var(--turquesa,#1FB0A6);color:var(--turquesa-fg,#10202A);cursor:pointer;transition:transform 140ms cubic-bezier(0.23,1,0.32,1)}.ds-btn-t:active{transform:scale(.97)}.ds-btn-t:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action on the cal shade.",
      "html": "<button class=\"ds-btn-g\">Ahora no</button>",
      "css": ".ds-btn-g{display:flex;align-items:center;justify-content:center;min-height:52px;padding:0 20px;border:0;border-radius:14px;font:750 16px/1 Archivo,system-ui,sans-serif;width:100%;background:var(--cal-2,#E3EBE7);color:var(--tinta,#172033);cursor:pointer;transition:transform 140ms cubic-bezier(0.23,1,0.32,1)}.ds-btn-g:active{transform:scale(.97)}.ds-btn-g:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}"
    },
    {
      "name": "Corridor Wall",
      "kind": "custom",
      "refersTo": "wall-abierta",
      "description": "Signature: road state as a painted field with a condensed rótulo; repaints by clip-path wipe. Toggle data-s to abierta, precaucion, bloqueo.",
      "html": "<section class=\"ds-wall\" data-s=\"bloqueo\"><i class=\"ds-paint\"></i><span class=\"ds-route\">Troncal del Caribe, Riohacha a Maicao</span><h2 class=\"ds-rotulo\">Bloqueo<br>en el km 42</h2><p class=\"ds-sub\">Vía cerrada confirmada por 9 reportes. Desvío por Albania y Cuestecitas.</p></section>",
      "css": ".ds-wall{container-type:inline-size;position:relative;overflow:hidden;padding:58px 20px 22px;background:var(--wall-bg);color:var(--wall-fg);font-family:Archivo,system-ui,sans-serif}.ds-wall[data-s=abierta]{--wall-bg:var(--turquesa,#1FB0A6);--wall-fg:var(--turquesa-fg,#10202A)}.ds-wall[data-s=precaucion]{--wall-bg:var(--ocre,#E9A825);--wall-fg:var(--ocre-fg,#172033)}.ds-wall[data-s=bloqueo]{--wall-bg:var(--coral,#C8412F);--wall-fg:var(--coral-fg,#FFFFFF)}.ds-paint{position:absolute;inset:0;background:var(--wall-bg);animation:ds-repaint 520ms cubic-bezier(0.23,1,0.32,1) both}.ds-wall>*:not(.ds-paint){position:relative}.ds-route{font-size:14px;font-weight:600;opacity:.92}.ds-rotulo{font-stretch:68%;font-weight:850;text-transform:uppercase;letter-spacing:.01em;line-height:.95;font-size:clamp(40px,17cqi,60px);margin:10px 0 6px;text-wrap:balance}.ds-sub{font-size:15px;max-width:30ch;margin:0}@keyframes ds-repaint{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}@media (prefers-reduced-motion:reduce){.ds-paint{animation-duration:1ms}}"
    },
    {
      "name": "Ask Card",
      "kind": "card",
      "refersTo": "ask-card",
      "description": "Primary entry to the assistant, overlapping the wall by 22px with an ink-tinted lift.",
      "html": "<button class=\"ds-ask\"><svg viewBox=\"0 0 256 256\" width=\"24\" height=\"24\" fill=\"currentColor\"><path d=\"M128 24a104 104 0 0 0-91.82 152.88l-11.35 34.05a16 16 0 0 0 20.24 20.24l34.05-11.35A104 104 0 1 0 128 24Zm-44 116a12 12 0 1 1 12-12 12 12 0 0 1-12 12Zm44 0a12 12 0 1 1 12-12 12 12 0 0 1-12 12Zm44 0a12 12 0 1 1 12-12 12 12 0 0 1-12 12Z\"/></svg><span><b>¿Para dónde vas?</b><small>Escribe o dile al asistente</small></span></button>",
      "css": ".ds-ask{display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:0;cursor:pointer;background:var(--muro,#FFFFFF);color:var(--tinta,#172033);border-radius:14px;padding:16px;font-family:Archivo,system-ui,sans-serif;box-shadow:0 10px 24px -14px rgb(23 32 51/.35),0 1px 0 rgb(23 32 51/.06)}.ds-ask svg{color:var(--turquesa-tx,#0A6F6B);flex:none}.ds-ask b{display:block;font-size:17px}.ds-ask small{color:var(--tinta-3,#6B7385);font-size:13px}.ds-ask:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}"
    },
    {
      "name": "Place Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Quick place pill, 44px tall.",
      "html": "<button class=\"ds-chip\">Palacio de Justicia <small>Maicao</small></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 14px;border-radius:999px;background:var(--muro,#FFFFFF);border:1px solid var(--linea,#CBD6D1);color:var(--tinta,#172033);font:600 14px Archivo,system-ui,sans-serif;cursor:pointer}.ds-chip small{color:var(--tinta-3,#6B7385);font-weight:500}.ds-chip:hover{border-color:var(--tinta-3,#6B7385)}.ds-chip:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}"
    },
    {
      "name": "State Tags",
      "kind": "chip",
      "refersTo": "tag-ok",
      "description": "Small pills on state washes.",
      "html": "<span class=\"ds-tag ds-t-ok\">En vivo</span> <span class=\"ds-tag ds-t-bad\">Vía cerrada</span> <span class=\"ds-tag ds-t-n\">Guardado en el teléfono</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:5px;font:700 12px Archivo,system-ui,sans-serif;padding:3px 8px;border-radius:999px;white-space:nowrap}.ds-t-ok{background:var(--turquesa-suave,#D3EAE6);color:var(--turquesa-tx,#0A6F6B)}.ds-t-bad{background:var(--coral-suave,#F7D9D2);color:var(--coral,#C8412F)}.ds-t-n{background:var(--cal-2,#E3EBE7);color:var(--tinta-2,#4A5568)}"
    },
    {
      "name": "Composer Input",
      "kind": "input",
      "refersTo": "input-composer",
      "description": "Chat composer: pill input with an ink send button.",
      "html": "<form class=\"ds-composer\"><input placeholder=\"Escribe a dónde vas\"><button type=\"button\" aria-label=\"Enviar\"><svg viewBox=\"0 0 256 256\" width=\"20\" height=\"20\" fill=\"currentColor\"><path d=\"M231.87 114l-168-95.89A16 16 0 0 0 40.92 37.34L71.55 128 40.92 218.67A16 16 0 0 0 56 240a16.15 16.15 0 0 0 7.93-2.1l167.92-96.05a16 16 0 0 0 .02-27.85Z\"/></svg></button></form>",
      "css": ".ds-composer{display:flex;gap:8px;padding:10px 12px;background:var(--cal,#F1F5F3);border-top:1px solid var(--linea,#CBD6D1)}.ds-composer input{flex:1;min-width:0;border:1px solid var(--linea,#CBD6D1);background:var(--muro,#FFFFFF);color:var(--tinta,#172033);border-radius:999px;padding:10px 16px;font:16px Archivo,system-ui,sans-serif}.ds-composer input:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}.ds-composer button{width:44px;height:44px;border-radius:50%;border:0;display:grid;place-items:center;background:var(--tinta,#172033);color:var(--cal,#F1F5F3);cursor:pointer}"
    },
    {
      "name": "Bottom Nav",
      "kind": "nav",
      "refersTo": "nav",
      "description": "Five items; active turns ink with Deep Lagoon icon; assistant is an ink pill.",
      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\"><i></i>Inicio</a><a><i></i>Corredor</a><a class=\"ds-ai\"><b></b>Asistente</a><a><i></i>Viaje</a><a><i></i>Perfil</a></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(5,1fr);padding:8px 8px 22px;background:var(--cal,#F1F5F3);border-top:1px solid var(--linea,#CBD6D1);font-family:Archivo,system-ui,sans-serif}.ds-nav a{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;font-weight:600;color:var(--tinta-3,#6B7385);padding:6px 0;min-height:44px;cursor:pointer}.ds-nav a i{width:24px;height:24px;border-radius:6px;background:currentColor;opacity:.9;margin:3px 0}.ds-nav a[aria-current=page]{color:var(--tinta,#172033)}.ds-nav a[aria-current=page] i{background:var(--turquesa-tx,#0A6F6B)}.ds-nav .ds-ai b{width:44px;height:30px;border-radius:999px;background:var(--tinta,#172033)}"
    },
    {
      "name": "Emergency Hold",
      "kind": "custom",
      "refersTo": "button-coral",
      "description": "Hold to confirm: coral fills by clip-path wipe over 1500ms.",
      "html": "<button class=\"ds-hold\"><i class=\"ds-fill\"></i><span class=\"ds-lbl\">Mantén para enviar alerta</span></button>",
      "css": ".ds-hold{position:relative;overflow:hidden;width:100%;min-height:56px;border:0;border-radius:14px;background:var(--coral-suave,#F7D9D2);color:var(--coral,#C8412F);font:800 16px Archivo,system-ui,sans-serif;cursor:pointer}.ds-fill{position:absolute;inset:0;background:var(--coral,#C8412F);clip-path:inset(0 100% 0 0);transition:clip-path 200ms cubic-bezier(0.23,1,0.32,1)}.ds-lbl{position:relative}.ds-hold:active .ds-fill{clip-path:inset(0 0 0 0);transition:clip-path 1500ms linear}.ds-hold:active .ds-lbl{color:var(--coral-fg,#FFFFFF)}.ds-hold:focus-visible{outline:3px solid var(--ocre,#E9A825);outline-offset:2px}"
    }
