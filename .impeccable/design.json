  "components": [
    {
      "name": "Placa de ruta",
      "kind": "custom",
      "refersTo": "route-plate",
      "description": "Gesto distintivo: destino, tramo, viaje o nombre como rótulo de parabrisas; activa con franja fucsia.",
      "html": "<div class=\"ds-plates\"><button class=\"ds-plate\"><span class=\"ds-plate-text\">Riohacha</span><svg class=\"ds-plate-arrow\" viewBox=\"0 0 24 24\" width=\"22\" height=\"22\"><path fill=\"currentColor\" d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"/></svg><span class=\"ds-plate-text\">Maicao</span><span class=\"ds-plate-detail\">Colectivo · $12.000 · sale 6:40</span></button><button class=\"ds-plate ds-plate-active\"><span class=\"ds-plate-text\">Terminal de Maicao</span><span class=\"ds-plate-detail\">Destino elegido</span></button></div>",
      "css": ".ds-plates{display:flex;flex-direction:column;gap:12px}.ds-plate{display:flex;flex-wrap:wrap;align-items:center;min-height:56px;padding:8px 16px 12px;background:#FFFFFF;border:1.5px solid #C9D0DC;border-radius:8px;color:#1B3A8C;text-align:left;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1);font-family: 'Barlow Condensed', 'Barlow', sans-serif;}.ds-plate-text{font-size:22px;font-weight:800;line-height:1.05;letter-spacing:0.4px;text-transform:uppercase}.ds-plate-arrow{margin:0 8px}.ds-plate-detail{flex-basis:100%;margin-top:2px;font-family: 'Barlow', sans-serif;font-size:15px;font-weight:500;color:#465066;font-variant-numeric:tabular-nums}.ds-plate:hover{background:#F4F6FB}.ds-plate:active{transform:scale(0.97)}.ds-plate:focus-visible{outline:2px solid #1B3A8C;outline-offset:2px}.ds-plate-active{border-color:#1B3A8C;padding-bottom:8px;box-shadow:inset 0 -4px 0 #C2185B}"
    },
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal: ultramar macizo, etiqueta condensada, presión 0,97.",
      "html": "<button class=\"ds-btn-primary\">Pagar viaje</button>",
      "css": ".ds-btn-primary{height:52px;padding:0 20px;width:100%;background:#1B3A8C;color:#FFFFFF;border:none;border-radius:8px;font-family: 'Barlow Condensed', 'Barlow', sans-serif;font-size:20px;font-weight:700;letter-spacing:0.3px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1),background 120ms}.ds-btn-primary:hover{background:#142C6B}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:2px solid #1B3A8C;outline-offset:3px}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción alterna sobre tinte de ultramar.",
      "html": "<button class=\"ds-btn-secondary\">Recargar</button>",
      "css": ".ds-btn-secondary{height:52px;padding:0 20px;width:100%;background:#E3E9F6;color:#1B3A8C;border:none;border-radius:8px;font-family: 'Barlow Condensed', 'Barlow', sans-serif;font-size:20px;font-weight:700;letter-spacing:0.3px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1)}.ds-btn-secondary:hover{background:#D6DEF1}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid #1B3A8C;outline-offset:3px}"
    },
    {
      "name": "Botón contorno",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Placa blanca con borde ultramar de 2 dp.",
      "html": "<button class=\"ds-btn-outline\">Ver detalle</button>",
      "css": ".ds-btn-outline{height:52px;padding:0 20px;width:100%;background:#FFFFFF;color:#1B3A8C;border:2px solid #1B3A8C;border-radius:8px;font-family: 'Barlow Condensed', 'Barlow', sans-serif;font-size:20px;font-weight:700;letter-spacing:0.3px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1)}.ds-btn-outline:hover{background:#E3E9F6}.ds-btn-outline:active{transform:scale(0.97)}.ds-btn-outline:focus-visible{outline:2px solid #1B3A8C;outline-offset:3px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo sobre placa blanca, foco en ultramar de 2 dp.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Correo</span><input class=\"ds-input\" placeholder=\"tu@correo.co\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px}.ds-field-label{font-family: 'Barlow', sans-serif;font-size:15px;font-weight:600;color:#111827}.ds-input{font-family: 'Barlow', sans-serif;font-size:17px;font-weight:500;color:#111827;background:#FFFFFF;border:1.5px solid #465066;border-radius:8px;padding:12px 16px;min-height:48px}.ds-input::placeholder{color:#8A93A6}.ds-input:hover{border-color:#111827}.ds-input:focus-visible{outline:none;border:2px solid #1B3A8C;padding:11.5px 15.5px}"
    },
    {
      "name": "Barra inferior",
      "kind": "nav",
      "refersTo": "bottom-nav",
      "description": "Carrocería ultramar; la pestaña activa es una pastilla blanca con franja fucsia.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item ds-nav-active\" href=\"#\"><span class=\"ds-nav-pill\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path fill=\"currentColor\" d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg></span>Inicio</a><a class=\"ds-nav-item\" href=\"#\"><span class=\"ds-nav-pill\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path fill=\"currentColor\" d=\"M21 18v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1h-9a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9zm-9-2h10V8H12v8zm4-2.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z\"/></svg></span>Billetera</a><a class=\"ds-nav-item\" href=\"#\"><span class=\"ds-nav-pill\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path fill=\"currentColor\" d=\"M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg></span>Perfil</a></nav>",
      "css": ".ds-nav{display:flex;min-height:72px;background:#1B3A8C}.ds-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-family: 'Barlow', sans-serif;font-size:13px;font-weight:500;color:#CCD7F2;text-decoration:none}.ds-nav-pill{display:flex;padding:4px 16px;border-radius:4px}.ds-nav-item:hover{color:#FFFFFF}.ds-nav-item:focus-visible{outline:2px solid #FFFFFF;outline-offset:-4px}.ds-nav-active{color:#FFFFFF;font-weight:700}.ds-nav-active .ds-nav-pill{background:#FFFFFF;color:#1B3A8C;box-shadow:inset 0 -4px 0 #C2185B}"
    },
    {
      "name": "Línea del corredor",
      "kind": "custom",
      "refersTo": "corridor-line",
      "description": "Estado de la Troncal Riohacha–Maicao: tramos en color vial, ícono + palabra y antigüedad tabular.",
      "html": "<div class=\"ds-corridor\"><div class=\"ds-corridor-track\"><div class=\"ds-corridor-ends\"><span>Riohacha</span><span>Maicao</span></div><div class=\"ds-corridor-line\"><i style=\"flex:5;background:#17602F\"></i><i style=\"flex:1;background:#9E1F18\"></i><i style=\"flex:4;background:#17602F\"></i></div></div><div class=\"ds-corridor-tag\"><span class=\"ds-corridor-word\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path fill=\"currentColor\" d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM4 12a8 8 0 0 1 12.9-6.3L5.7 16.9A7.9 7.9 0 0 1 4 12zm8 8a7.9 7.9 0 0 1-4.9-1.7L18.3 7.1A8 8 0 0 1 12 20z\"/></svg>Cerrada</span><span class=\"ds-corridor-age\">hace 12 min</span></div></div>",
      "css": ".ds-corridor{display:flex;align-items:center;gap:12px;height:56px;padding:0 16px;background:#FFFFFF;border-bottom:1px solid #C9D0DC;font-family: 'Barlow', sans-serif;}.ds-corridor:hover{background:#F7F9FC}.ds-corridor:focus-visible{outline:2px solid #1B3A8C}.ds-corridor-track{flex:1}.ds-corridor-ends{display:flex;justify-content:space-between;font-size:14px;font-weight:600;color:#465066}.ds-corridor-line{display:flex;height:6px;margin:5px 4px 0}.ds-corridor-tag{display:flex;flex-direction:column;align-items:flex-end}.ds-corridor-word{display:flex;align-items:center;gap:4px;font-size:14px;font-weight:700;color:#9E1F18}.ds-corridor-age{font-size:12px;font-weight:600;color:#465066;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Fila plana",
      "kind": "card",
