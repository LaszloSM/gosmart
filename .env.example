# Supabase — get from https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps — https://console.cloud.google.com (Maps SDK for Android).
# Búsqueda y rutas NO usan esta clave: van por la Edge Function `maps`
# con el secret GOOGLE_MAPS_SERVER_KEY. Sin clave, el mapa es OpenStreetMap.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Groq NO va aquí: es un secret de la Edge Function ai-chat
# (Supabase Dashboard → Edge Functions → Secrets → GROQ_API_KEY).

# Sentry — opcional, plan gratis en https://sentry.io. Vacío = sin reporte de errores
SENTRY_DSN=

# Map provider: google or osm
MAP_PROVIDER=google

# Página pública del viaje compartido (public_web/ en GitHub Pages), con / al final.
# Ej: https://tu-usuario.github.io/gosmart/  Vacío = el SOS y el compartir
# mandan solo el punto en Google Maps.
SHARE_BASE_URL=
